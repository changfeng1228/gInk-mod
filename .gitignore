# --- build output and local run data ---
# build/res/ holds the .resources the compiler embeds; they are produced once by
# build/extract-resources.ps1 from the upstream 1.1.1 exe and are required to compile.
# Everything else under build/ and release/ is output or scratch.
build/*
!build/res/
!build/res/*.resources
!build/ExtractResources.cs
!build/extract.exe
!build/extract-resources.ps1
!build/mk_rsp.py
!build/verify_res.py
!build/build.ps1
release/
build/_scratch/

# --- Rust ---
plnk/target/

# --- IDE / symbols ---
*.pdb
*.exp
*.sdf
*.suo
*.opensdf
*.lnk
*vshost.exe*

# --- runtime data next to the executable, never committed ---
# The program writes these when the user changes settings, so they are per-install
# data. config_default.ini is the factory template and IS committed: build.ps1 ships
# it so a fresh install has a reference copy of the defaults.
bin/*.exe
bin/*.dll
bin/*.ini
!bin/config_default.ini
bin/crash.txt
bin/gInk_debug.log

# --- tianshu (agent runtime) working files ---
.rivet/
.rivet.md
